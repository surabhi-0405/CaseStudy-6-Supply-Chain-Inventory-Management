USE supply_chain_inventory;

SELECT
    Product_ID,
    COUNT(*) AS Total_Transactions,
    SUM(Quantity_Sold) AS Total_Quantity_Sold,
    ROUND(SUM(Revenue), 2) AS Total_Revenue,
    ROUND(AVG(Quantity_Sold), 2) AS Avg_Quantity_Per_Transaction,

    CASE
        WHEN SUM(Quantity_Sold) >= (
            SELECT AVG(Product_Total)
            FROM (
                SELECT
                    Product_ID,
                    SUM(Quantity_Sold) AS Product_Total
                FROM sales_data
                GROUP BY Product_ID
            ) AS Product_Averages
        )
        THEN 'Fast-Moving'
        ELSE 'Slow-Moving'
    END AS Movement_Category

FROM sales_data
GROUP BY Product_ID
ORDER BY Total_Quantity_Sold DESC;
-------------------------------------------------------------------------------------------
USE supply_chain_inventory;

SELECT
    Product_ID,
    COUNT(*) AS Inventory_Records,
    SUM(Stock_Level) AS Current_Stock,
    SUM(Reorder_Level) AS Total_Reorder_Level,

    SUM(
        CASE
            WHEN Stock_Level < Reorder_Level THEN 1
            ELSE 0
        END
    ) AS Below_Reorder_Count,

    ROUND(
        SUM(
            CASE
                WHEN Stock_Level < Reorder_Level THEN 1
                ELSE 0
            END
        ) * 100.0 / COUNT(*),
        2
    ) AS Reorder_Risk_Percentage,

    SUM(Reorder_Level) - SUM(Stock_Level) AS Stock_Gap

FROM inventory_data
GROUP BY Product_ID
ORDER BY Reorder_Risk_Percentage DESC;
