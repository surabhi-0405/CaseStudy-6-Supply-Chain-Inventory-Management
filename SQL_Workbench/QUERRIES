FROM fact_purchase_orders
LIMIT 5;
-------------------------------------------------------------------------------------------
USE supply_chain_inventory;

INSERT INTO fact_purchase_orders (
    Order_ID,
    Product_Key,
    Supplier_Key,
    Order_Date_Key,
    Arrival_Date_Key,
    Quantity,
    Actual_Lead_Time_Days
)
SELECT
    po.Order_ID,
    p.Product_Key,
    s.Supplier_Key,
    od.Date_Key,
    ad.Date_Key,
    po.Quantity,
    DATEDIFF(po.Arrival_Date, po.Order_Date) AS Actual_Lead_Time_Days
FROM purchase_orders po
JOIN dim_product p
    ON po.Product_ID = p.Product_ID
JOIN dim_supplier s
    ON po.Supplier_ID = s.Supplier_ID
JOIN dim_date od
    ON po.Order_Date = od.Full_Date
JOIN dim_date ad
    ON po.Arrival_Date = ad.Full_Date;

SELECT
    COUNT(*) AS Total_PO_Records,
    SUM(Quantity) AS Total_Quantity_Ordered,
    ROUND(AVG(Actual_Lead_Time_Days), 2) AS Avg_Actual_Lead_Time,
    MIN(Actual_Lead_Time_Days) AS Min_Actual_Lead_Time,
    MAX(Actual_Lead_Time_Days) AS Max_Actual_Lead_Time
FROM fact_purchase_orders;
