SELECT
    'Sales' AS Data_Check,
    (SELECT COUNT(*) FROM sales_data) AS Source_Rows,
    (SELECT COUNT(*) FROM fact_sales) AS Warehouse_Rows,
    (SELECT SUM(Quantity_Sold) FROM sales_data) AS Source_Quantity,
    (SELECT SUM(Quantity_Sold) FROM fact_sales) AS Warehouse_Quantity,
    (SELECT ROUND(SUM(Revenue), 2) FROM sales_data) AS Source_Revenue,
    (SELECT ROUND(SUM(Revenue), 2) FROM fact_sales) AS Warehouse_Revenue

UNION ALL

SELECT
    'Inventory',
    (SELECT COUNT(*) FROM inventory_data),
    (SELECT COUNT(*) FROM fact_inventory),
    (SELECT SUM(Stock_Level) FROM inventory_data),
    (SELECT SUM(Stock_Level) FROM fact_inventory),
    (SELECT SUM(Reorder_Level) FROM inventory_data),
    (SELECT SUM(Reorder_Level) FROM fact_inventory)

UNION ALL

SELECT
    'Purchase Orders',
    (SELECT COUNT(*) FROM purchase_orders),
    (SELECT COUNT(*) FROM fact_purchase_orders),
    (SELECT SUM(Quantity) FROM purchase_orders),
    (SELECT SUM(Quantity) FROM fact_purchase_orders),
    (SELECT ROUND(AVG(DATEDIFF(Arrival_Date, Order_Date)), 2)
     FROM purchase_orders),
    (SELECT ROUND(AVG(Actual_Lead_Time_Days), 2)
     FROM fact_purchase_orders);
