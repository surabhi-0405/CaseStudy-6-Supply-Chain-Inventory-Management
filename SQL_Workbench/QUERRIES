USE supply_chain_inventory;

SELECT
    s.Product_ID,
    COUNT(DISTINCT s.Supplier_ID) AS Supplier_Count,

    ROUND(AVG(s.`Lead_Time (days)`), 2) AS Avg_Lead_Time_Days,
    MIN(s.`Lead_Time (days)`) AS Min_Lead_Time_Days,
    MAX(s.`Lead_Time (days)`) AS Max_Lead_Time_Days,

    COUNT(po.Order_ID) AS Total_Purchase_Orders,
    COALESCE(SUM(po.Quantity), 0) AS Total_Quantity_Ordered,

    ROUND(
        COALESCE(AVG(po.Quantity), 0),
        2
    ) AS Avg_Order_Quantity

FROM suppliers_data s

LEFT JOIN purchase_orders po
    ON s.Supplier_ID = po.Supplier_ID

GROUP BY s.Product_ID
ORDER BY Avg_Lead_Time_Days DESC;
