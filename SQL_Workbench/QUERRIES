INSERT INTO dim_date (
    Date_Key,
    Full_Date,
    Year,
    Month,
    Month_Name,
    Quarter,
    `Year_Month`
)
WITH RECURSIVE date_series AS (
    SELECT DATE('2024-01-01') AS Full_Date

    UNION ALL

    SELECT DATE_ADD(Full_Date, INTERVAL 1 DAY)
    FROM date_series
    WHERE Full_Date < DATE('2037-09-08')
)
SELECT
    CAST(DATE_FORMAT(Full_Date, '%Y%m%d') AS UNSIGNED) AS Date_Key,
    Full_Date,
    YEAR(Full_Date) AS Year,
    MONTH(Full_Date) AS Month,
    MONTHNAME(Full_Date) AS Month_Name,
    CONCAT('Q', QUARTER(Full_Date)) AS Quarter,
    DATE_FORMAT(Full_Date, '%Y-%m') AS `Year_Month`
FROM date_series;

SELECT
    COUNT(*) AS Total_Dates,
    MIN(Full_Date) AS Start_Date,
    MAX(Full_Date) AS End_Date
FROM dim_date;
