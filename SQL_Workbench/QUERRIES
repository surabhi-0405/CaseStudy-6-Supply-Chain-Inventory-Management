INSERT INTO fact_sales (
    Sale_ID,
    Date_Key,
    Product_Key,
    Store_Key,
    Quantity_Sold,
    Revenue
)
SELECT
    s.Sale_ID,
    d.Date_Key,
    p.Product_Key,
    st.Store_Key,
    s.Quantity_Sold,
    s.Revenue
FROM sales_data s
JOIN dim_date d
    ON s.Sale_Date = d.Full_Date
JOIN dim_product p
    ON s.Product_ID = p.Product_ID
JOIN dim_store st
    ON s.Store_ID = st.Store_ID;

SELECT
    COUNT(*) AS Total_Sales_Records,
    SUM(Quantity_Sold) AS Total_Quantity_Sold,
    ROUND(SUM(Revenue), 2) AS Total_Revenue
FROM fact_sales;
