USE supply_chain_inventory;

WITH Product_Sales AS (
    SELECT
        Product_ID,
        SUM(Quantity_Sold) AS Total_Quantity_Sold,
        SUM(Revenue) AS Total_Revenue
    FROM sales_data
    GROUP BY Product_ID
),

Product_Inventory AS (
    SELECT
        Product_ID,
        SUM(Stock_Level) AS Current_Stock,
        SUM(Reorder_Level) AS Total_Reorder_Level,

        SUM(
            CASE
                WHEN Stock_Level < Reorder_Level THEN 1
                ELSE 0
            END
        ) AS Below_Reorder_Count,

        ROUND(
            SUM(
                CASE
                    WHEN Stock_Level < Reorder_Level THEN 1
                    ELSE 0
                END
            ) * 100.0 / COUNT(*),
            2
        ) AS Reorder_Risk_Percentage

    FROM inventory_data
    GROUP BY Product_ID
),

Sales_Threshold AS (
    SELECT
        AVG(Total_Quantity_Sold) AS Avg_Product_Quantity
    FROM Product_Sales
)

SELECT
    ps.Product_ID,
    ps.Total_Quantity_Sold,
    ROUND(ps.Total_Revenue, 2) AS Total_Revenue,

    CASE
        WHEN ps.Total_Quantity_Sold >= st.Avg_Product_Quantity
        THEN 'Fast-Moving'
        ELSE 'Slow-Moving'
    END AS Movement_Category,

    pi.Current_Stock,
    pi.Total_Reorder_Level,
    pi.Below_Reorder_Count,
    pi.Reorder_Risk_Percentage

FROM Product_Sales ps
JOIN Product_Inventory pi
    ON ps.Product_ID = pi.Product_ID
CROSS JOIN Sales_Threshold st

ORDER BY ps.Total_Quantity_Sold DESC;
