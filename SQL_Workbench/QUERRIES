)
SELECT
    d.Date_Key,
    p.Product_Key,
    st.Store_Key,
    i.Warehouse_ID,
    i.Stock_Level,
    i.Reorder_Level
FROM inventory_data i
JOIN dim_date d
    ON i.Last_Updated = d.Full_Date
JOIN dim_product p
    ON i.Product_ID = p.Product_ID
JOIN dim_store st
    ON i.Store_ID = st.Store_ID;

